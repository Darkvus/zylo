{
  "comments": { "lineComment": "#" },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["'", "'"]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(fn|struct|if|elif|else|while|for)\\b.*:\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*(elif|else)\\b.*:\\s*(#.*)?$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(fn|struct|if|elif|else|while|for)\\b.*:\\s*(#.*)?$",
      "action": { "indent": "indent" }
    }
  ],
  "folding": { "offSide": true }
}
