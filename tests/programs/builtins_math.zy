nums = [3.5, -1.25, 8.0]
print(sum(nums), min(nums), max(nums), abs(-7), abs(-2.5))
print(sorted([5, 2, 9, 1]), reversed(["a", "b", "c"]))
print(sqrt(2.0), pow(2.0, 0.5), round(2.6), round(-2.6), floor(-1.5), ceil(1.2))
for i, c in enumerate("abc".chars()):
    print(i, c)
for a, b in zip([1, 2, 3], ["x", "y"]):
    print(a, b)
print(max(3, 9), min(2.5, 1.5), max("pear", "apple"))
print(round(2.5), round(-2.5))
