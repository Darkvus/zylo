fn stats(xs: list[int]) -> tuple[int, int, float]:
    return min(xs), max(xs), float(sum(xs)) / float(len(xs))

lo, hi, avg = stats([4, 8, 15, 16, 23, 42])
print(f"min={lo} max={hi} avg={avg:.2f}")
point = 3, 4
x, y = point
x, y = y, x
print(point, x, y, point[0] + point[1])
rows = [("ana", 30), ("bob", 25), ("cy", 41)]
for name, age in rows:
    print(f"{name:<5}|{age:>4}|{age:04d}")
best = rows[0]
for r in rows:
    if r[1] > best[1]:
        best = r
print(best, best == ("cy", 41))
print(f"{1 + 2} {'q'} {{literal}} {len(rows)} {[1, 2]} {point}")
print("tab\there", "single \"quotes\"", "back\\slash")
