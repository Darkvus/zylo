enum Color:
    Red
    Green
    Blue
    Rgb(int, int)
    Gray(int)

fn name(c: Color) -> str:
    match c:
        Color.Red | Color.Green:
            return "warm-ish"
        Color.Rgb(a, b) if a > b:
            return "a>b"
        Color.Rgb(a, _) | Color.Gray(a):
            return "x"
        Color.Blue:
            return "blue"

fn num(n: int) -> str:
    match n:
        1 | 2:
            return "small"
        3 if n > 2:
            return "three"
        _ if n < 0:
            return "neg"
        _:
            return "big"

fn word(s: str, o: int?) -> int:
    match s:
        "a" | "b":
            return 1
        _:
            match o:
                some(x) if x > 5:
                    return x
                some(_) | none:
                    return 0

print(
    name(Color.Red),
    name(Color.Rgb(3, 1)),
    name(Color.Gray(1)),
    num(2),
    num(3),
    num(-4),
    num(9),
    word("a", none),
    word("z", some(9)),
)
