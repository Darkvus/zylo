enum Shape:
    Circle(float)
    Rect(float, float)
    Empty

enum Cmd:
    Push(int)
    Add
    Say(str, int)
    Stop

struct Machine:
    stack: list[int]

    fn run(self, c: Cmd) -> bool:
        match c:
            Cmd.Push(n):
                self.stack.append(n)
            Cmd.Add:
                a = self.stack.pop().unwrap()
                b = self.stack.pop().unwrap()
                self.stack.append(a + b)
            Cmd.Say(text, times):
                times += 1
                for i in range(times):
                    print(f"{text} {i}")
            Cmd.Stop:
                return false
        return true

fn area(s: Shape) -> float:
    match s:
        Shape.Circle(r):
            return 3.0 * r * r
        Shape.Rect(w, h):
            return w * h
        Shape.Empty:
            return 0.0

shapes = [Shape.Circle(2.0), Shape.Rect(2.0, 3.5), Shape.Empty]
total = 0.0
for s in shapes:
    total += area(s)
print(total)
print(shapes)
print(shapes[0] == Shape.Circle(2.0), shapes[1] == Shape.Empty)

m = Machine([])
for c in [Cmd.Push(2), Cmd.Push(40), Cmd.Add, Cmd.Say("hi", 1), Cmd.Stop, Cmd.Push(9)]:
    if not m.run(c):
        break
print(m.stack)

x = Cmd.Add
match x:
    Cmd.Push(_):
        print("push")
    _:
        print(f"other: {x}")
