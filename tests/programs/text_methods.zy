s = "  Hello, World  "
t = s.strip()
print(t)
print(t.upper(), t.lower())
print(t.replace("World", "Zylo"))
print(t.split(", "))
print(t.startswith("Hello"), t.endswith("x"))
print(t.find("World"), t.find("nope"))
print("a-b-c".split("-"))
print(",".join(["x", "y", "z"]))
print("banana".count("an"))
print("ab".repeat(3))
print(len("héllo"), "héllo".upper())
print("one  two\tthree".split())
print("l1\nl2\nl3".lines())
print("abc".chars())
print("lo" in t, "z" not in t)
