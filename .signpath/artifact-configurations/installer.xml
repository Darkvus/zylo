<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": the GitHub artifact is a zip that holds the
     Inno Setup installer, which is signed with Authenticode. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="zylo-setup-x86_64.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
