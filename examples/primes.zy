# Primes up to 50 by trial division
fn is_prime(n: int) -> bool:
    if n < 2:
        return false
    d = 2
    while d * d <= n:
        if n % d == 0:
            return false
        d += 1
    return true

count = 0
for n in range(1, 51):
    if is_prime(n):
        print(n)
        count += 1
print("total:")
print(count)
