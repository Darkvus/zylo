# Binary search: index of the element, or -1
fn search(xs: list[int], target: int) -> int:
    lo = 0
    hi = len(xs) - 1
    while lo <= hi:
        mid = (lo + hi) / 2
        if xs[mid] == target:
            return mid
        elif xs[mid] < target:
            lo = mid + 1
        else:
            hi = mid - 1
    return -1

sorted_data = [1, 3, 5, 7, 9, 11, 13, 15]
print(search(sorted_data, 7))
print(search(sorted_data, 1))
print(search(sorted_data, 15))
print(search(sorted_data, 4))
