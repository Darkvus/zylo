# Inicio menor que 1000 con la secuencia de Collatz más larga
fn steps(n: int) -> int:
    count = 0
    while n != 1:
        if n % 2 == 0:
            n = n / 2
        else:
            n = 3 * n + 1
        count += 1
    return count

best = 1
best_steps = 0
for start in range(1, 1000):
    s = steps(start)
    if s > best_steps:
        best_steps = s
        best = start
print(best)
print(best_steps)
