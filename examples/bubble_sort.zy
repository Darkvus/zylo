# Bubble sort. Lists are passed by value: `data` does not change.
fn bubble_sort(xs: list[int]) -> list[int]:
    n = len(xs)
    for i in range(n):
        for j in range(n - 1 - i):
            if xs[j] > xs[j + 1]:
                tmp = xs[j]
                xs[j] = xs[j + 1]
                xs[j + 1] = tmp
    return xs

data = [64, 34, 25, 12, 22, 11, 90, 5]
print(data)
print(bubble_sort(data))
print(data)
