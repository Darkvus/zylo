# std.math: the math that is not a built-in (`sqrt`, `pow`, `abs`, `floor`, `ceil`, `round`, `min`, `max` already are).
# Angles are in radians. A module cannot hold constants yet, so the constants are functions: `math.pi()`.

fn pi() -> float:
    return 3.141592653589793

fn tau() -> float:
    return 6.283185307179586

fn e() -> float:
    return 2.718281828459045

extern fn sin(x: float) -> float = "{0}.sin()"

extern fn cos(x: float) -> float = "{0}.cos()"

extern fn tan(x: float) -> float = "{0}.tan()"

extern fn asin(x: float) -> float = "{0}.asin()"

extern fn acos(x: float) -> float = "{0}.acos()"

extern fn atan(x: float) -> float = "{0}.atan()"

extern fn atan2(y: float, x: float) -> float = "{0}.atan2({1})"

extern fn sinh(x: float) -> float = "{0}.sinh()"

extern fn cosh(x: float) -> float = "{0}.cosh()"

extern fn tanh(x: float) -> float = "{0}.tanh()"

extern fn exp(x: float) -> float = "{0}.exp()"

# The natural logarithm.
extern fn ln(x: float) -> float = "{0}.ln()"

extern fn log2(x: float) -> float = "{0}.log2()"

extern fn log10(x: float) -> float = "{0}.log10()"

extern fn log(x: float, base: float) -> float = "{0}.log({1})"

extern fn cbrt(x: float) -> float = "{0}.cbrt()"

# The length of the hypotenuse: sqrt(a*a + b*b) without intermediate overflow.
extern fn hypot(a: float, b: float) -> float = "{0}.hypot({1})"

# The integer part of x, as a float (toward zero).
extern fn trunc(x: float) -> float = "{0}.trunc()"

extern fn is_nan(x: float) -> bool = "{0}.is_nan()"

extern fn is_finite(x: float) -> bool = "{0}.is_finite()"

fn radians(degrees: float) -> float:
    return degrees * pi() / 180.0

fn degrees(radians: float) -> float:
    return radians * 180.0 / pi()

# x limited to the range lo..hi.
fn clamp(x: float, lo: float, hi: float) -> float:
    return min(max(x, lo), hi)

fn clamp_int(x: int, lo: int, hi: int) -> int:
    return min(max(x, lo), hi)

# -1, 0 or 1 according to the sign of x.
fn sign(x: int) -> int:
    if x < 0:
        return -1
    if x > 0:
        return 1
    return 0

# The greatest common divisor of two integers (never negative).
fn gcd(a: int, b: int) -> int:
    x = abs(a)
    y = abs(b)
    while y != 0:
        t = x % y
        x = y
        y = t
    return x

# The least common multiple (0 when either is 0).
fn lcm(a: int, b: int) -> int:
    if a == 0 or b == 0:
        return 0
    return abs(a / gcd(a, b) * b)
